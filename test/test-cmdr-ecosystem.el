;;; test-cmdr-ecosystem.el --- Tests for the ecosystem specs -*- lexical-binding: t; -*-

;;; Code:
(require 'ert)
(require 'cmdr-keys)
(require 'cmdr-ecosystem)

(ert-deftest cmdr-ecosystem-test/load-does-not-install ()
  (let ((cmdr-mode-map (make-sparse-keymap)))
    (load "cmdr-ecosystem" nil t)
    (should (equal cmdr-mode-map (make-sparse-keymap)))))

(ert-deftest cmdr-ecosystem-test/install-is-idempotent ()
  (let ((cmdr-mode-map (make-sparse-keymap))
        (names '(clipboard magit smerge docker shell eat anzu dape projectile popper ediff mailx diff-review)))
    (seq-do #'cmdr-spec-install names)
    (let ((snapshot (copy-keymap cmdr-mode-map)))
      (seq-do #'cmdr-spec-install names)
      (should (equal snapshot cmdr-mode-map)))
    (should (commandp (keymap-lookup cmdr-mode-map "C-c C-d")))
    (should (commandp (keymap-lookup cmdr-mode-map "C-c p")))
    (should (eq (keymap-lookup cmdr-mode-map "C-x x c") #'execute-extended-clipboard-command))
    (should (eq (keymap-lookup cmdr-mode-map "C-x g s") #'magit-status))
    (should (eq (keymap-lookup cmdr-mode-map "C-x g v") #'magit-dash-review-select))
    (should (eq (keymap-lookup cmdr-mode-map "C-x d c") #'docker-containers))
    (should (eq (keymap-lookup cmdr-mode-map "C-c s e e") #'eat))
    (should (eq (keymap-lookup cmdr-mode-map "C-c q r") #'anzu-query-replace))
    (should (eq (keymap-lookup cmdr-mode-map "C-c '") #'popper-toggle))
    (should (eq (keymap-lookup cmdr-mode-map "C-c C-'") #'popper-toggle))
    (should (eq (keymap-lookup cmdr-mode-map "C-c \\") #'popper-cycle))
    (should (eq (keymap-lookup cmdr-mode-map "C-c /") #'switch-to-popup-buffer))
    (should (eq (keymap-lookup cmdr-mode-map "C-c M-'") #'popper-kill-latest-popup))
    (should (eq (keymap-lookup cmdr-mode-map "C-c C-M-'") #'popper-toggle-type))
    (should (eq (keymap-lookup cmdr-mode-map "C-c m a") #'mailx-select-account))
    (should (eq (keymap-lookup cmdr-mode-map "C-c m v") #'mailx-jump-to-tier))
    (should (eq (keymap-lookup cmdr-mode-map "C-c m s") #'mailx-bulk-stage-current-view))
    (should (eq (keymap-lookup cmdr-mode-map "C-c o c") #'mailx-capture-task))
    (should (eq (keymap-lookup cmdr-mode-map "C-c m r") #'mailx-generate-refile-rule))
    (should (eq (keymap-lookup cmdr-mode-map "C-c m u") #'mailx-sync-and-classify-async))
    (should (eq popper-display-control nil))
    (should (member 'help-mode popper-reference-buffers))
    (should (member 'arch-install-mode popper-reference-buffers))
    (should (member 'agent-shell-queue-item-view-mode popper-reference-buffers))
    (should (member 'compilation-mode popper-reference-buffers))
    (should (member 'messages-buffer-mode popper-reference-buffers))
    (should (member 'grep-mode popper-reference-buffers))
    (should (member 'occur-mode popper-reference-buffers))
    (should (eq ediff-window-setup-function 'ediff-setup-windows-plain))
    (should (eq ediff-split-window-function 'split-window-horizontally))))

(defvar magit-mode-map nil)

(ert-deftest cmdr-ecosystem-test/magit-keymap-bindings ()
  (let ((magit-mode-map (make-sparse-keymap))
        (features features))
    (setq magit-command-mode-map nil)
    (cmdr-spec-install 'magit)
    (should magit-command-mode-map)
    (should (eq (keymap-lookup magit-mode-map "/") magit-command-mode-map))
    (should (eq (keymap-lookup magit-command-mode-map "x") 'execute-extended-magit-command))
    (should (eq (keymap-lookup magit-command-mode-map "m") 'execute-extended-smerge-command))))

(ert-deftest cmdr-ecosystem-test/cmdr-git-link-enables-clipboard ()
  "Invoking `cmdr-git-link' forces `select-enable-clipboard' to t."
  (let ((select-enable-clipboard nil)
        captured)
    (should (fboundp 'cmdr-git-link))
    (cl-letf (((symbol-function 'call-interactively)
               (lambda (fn &rest _)
                 (when (eq fn #'git-link)
                   (setq captured select-enable-clipboard)))))
      (cmdr-git-link)
      (should (eq captured t))
      (should (eq select-enable-clipboard nil)))))

(defvar mu4e-main-mode-hook nil)
(defvar mu4e-headers-mode-hook nil)
(defvar mu4e-view-mode-hook nil)
(defvar mu4e-compose-mode-hook nil)

(ert-deftest cmdr-ecosystem-test/mailx-does-not-register-home-frame-hooks ()
  "Mailx owns the lifetime of its home-frame hooks."
  (should-not (cmdr-spec-activate-hook (cmdr-spec-get 'mailx))))

(defvar diff-review-file-command-map nil)
(defvar diff-review-mode-map nil)

(ert-deftest cmdr-ecosystem-test/diff-review-keymap-bindings ()
  (let ((cmdr-mode-map (make-sparse-keymap))
        (diff-review-file-command-map (make-sparse-keymap))
        (diff-review-mode-map (make-sparse-keymap))
        (features features))
    (unwind-protect
        (progn
          (provide 'diff-review)
          (cmdr-spec-install 'diff-review)
          (should (eq (keymap-lookup diff-review-file-command-map "e") #'magit-dash-review-send-to-agent))
          (should (eq (keymap-lookup diff-review-file-command-map "h") #'magit-dash-review-stage-hitl))
          (should (eq (keymap-lookup diff-review-file-command-map "k") #'magit-dash-review-critique-hunk))
          (should (eq (keymap-lookup diff-review-file-command-map "w") #'magit-dash-review-draft-test))
          (should (eq (keymap-lookup diff-review-file-command-map "a") #'magit-dash-review-promote-draft))
          (should (eq (keymap-lookup diff-review-file-command-map "s") #'magit-dash-review-submit))
          (should (eq (keymap-lookup diff-review-file-command-map "y") #'magit-dash-review-sync))
          (should (eq (keymap-lookup diff-review-mode-map "e") #'magit-dash-review-send-to-agent))
          (should (eq (keymap-lookup diff-review-mode-map "h") #'magit-dash-review-stage-hitl))
          (should (eq (keymap-lookup diff-review-mode-map "s") #'magit-dash-review-submit))
          (should (eq (keymap-lookup diff-review-mode-map "y") #'magit-dash-review-sync))
          (should (eq (keymap-lookup diff-review-mode-map "b") #'magit-dash-review-open-backend)))
      (when (bound-and-true-p diff-review-magit-mode)
        (diff-review-magit-mode -1)))))

(ert-deftest cmdr-ecosystem-test/grepx-spec-registered ()
  "The grepx spec is registered with deferred keymap and activate hook."
  (let ((spec (cmdr-spec-get 'grepx)))
    (should spec)
    (should (equal (cmdr-spec-feature spec) 'grepx))
    (should (equal (cmdr-spec-activate-hook spec) '(grepx-mode)))
    (should (equal (cmdr-spec-deferred-keymaps spec)
                   '(("C-c g" grepx grepx-command-map "grepx"))))))

(ert-deftest cmdr-ecosystem-test/telega-spec-registered ()
  "The telega spec is registered with deferred keymaps and telegax activate hook."
  (let ((spec (cmdr-spec-get 'telega)))
    (should spec)
    (should (equal (cmdr-spec-feature spec) 'telegax))
    (should (equal (cmdr-spec-activate-hook spec) '(telegax-mode)))
    (should (equal (cmdr-spec-deferred-keymaps spec)
                   '(("C-c v" telegax telega-prefix-map "telega")
                     ("C-c n" telegax telega-prefix-map "telega"))))))

(ert-deftest cmdr-ecosystem-test/builder-spec-registered ()
  "The builder spec is registered with compile binding and builder-mode activate hook."
  (let ((spec (cmdr-spec-get 'builder)))
    (should spec)
    (should (equal (cmdr-spec-feature spec) 'builder-mode))
    (should (equal (cmdr-spec-activate-hook spec) '(builder-mode)))
    (should (equal (cmdr-spec-bindings spec)
                   '(("C-c t c" . builder-compile))))))

(defvar afp-suppress-fill-pfunction-list)
(defvar afp-fill-comments-only-mode-list)

(ert-deftest cmdr-ecosystem-test/fill-spec-registered ()
  "The fill spec wires aggressive-fill-paragraph to the orgx-fill policy."
  (let ((spec (cmdr-spec-get 'fill)))
    (should spec)
    (should (equal (cmdr-spec-feature spec) 'aggressive-fill-paragraph))
    (should (equal (cmdr-spec-probe spec) 'orgx-fill-guard-mode))
    (should (equal (cmdr-spec-activate-hook spec) '(cmdr-fill--suppress-in-aggressive-fill)))))

(ert-deftest cmdr-ecosystem-test/fill-activation-registers-predicate ()
  (let ((afp-suppress-fill-pfunction-list (list #'ignore))
        (had-feature (featurep 'orgx-fill)))
    (unwind-protect
        (progn
          (provide 'orgx-fill)
          (cmdr-fill--suppress-in-aggressive-fill)
          (cmdr-fill--suppress-in-aggressive-fill)
          (should (equal afp-suppress-fill-pfunction-list '(orgx-fill-suppressed-p ignore))))
      (unless had-feature
        (setq features (delq 'orgx-fill features))))))

(ert-deftest cmdr-ecosystem-test/aggressive-fill-spec-settings ()
  "The aggressive-fill spec limits aggressive filling to comments in prog modes."
  (let ((spec (cmdr-spec-get 'aggressive-fill))
        (afp-fill-comments-only-mode-list '(emacs-lisp-mode sh-mode)))
    (should spec)
    (should (equal (cmdr-spec-probe spec) "aggressive-fill-paragraph"))
    (cmdr-spec--apply-settings (cmdr-spec-settings spec))
    (should (equal afp-fill-comments-only-mode-list '(prog-mode)))))

(provide 'test-cmdr-ecosystem)
